#: ../../WPrefs.app/Expert.c:83
msgid "Enable virtual desktop (pannable workspaces larger than the screen)."
msgstr ""
"ვირტუალური დესკტოპის ჩართვა (ეკრანზე დიდი, გადასაადგილებელი სამუშაო "
"სივრცეები)."

#: ../../WPrefs.app/Expert.c:87
msgid "Cycle all windows from all workspaces."
msgstr "ყველა ფანჯრის წრიული გადართვა ყველა სამუშაო სივრციდან."

#: ../../WPrefs.app/Expert.c:90
msgid "Ignore minimized windows when cycling."
msgstr "ჩაკეცილი ფანჯრების იგნორი წრიული გადართვისას."

#: ../../WPrefs.app/Expert.c:93
msgid "Order the switch panel by creation time instead of focus history."
msgstr "გადამრთველი პანელის დალაგება შექმნის დროით, ფოკუსის ისტორიის ნაცვლად."

#: ../../WPrefs.app/Expert.c:96
msgid "Show app icons in window list."
msgstr "აპის ხატულების ჩვენება ფანჯრების სიაში."

#: ../../WPrefs.app/Expert.c:99
msgid "Show switch panel when cycling windows."
msgstr "გადართვის პანელის ჩვენება ფანჯრებს შორის წრიული გადართვისას."

#: ../../WPrefs.app/Expert.c:102
msgid "Show every tab-group member in the window switch panel."
msgstr "ყველა ჩანართის-ჯგუფის წევრის ჩვენება ფანჯრების გადამრთველ პანელში."

#: ../../WPrefs.app/Expert.c:105
msgid "Draw tab groups as titlebar segments instead of a [N/M] prefix."
msgstr ""
"ჩანართების ჯგუფების გამოსახვა სათაურის ზოლის სეგმენტებად, [N/M] პრეფიქსის "
"ნაცვლად."

#: ../../WPrefs.app/Expert.c:108
msgid "Accept tab drops anywhere on the target window, not just its titlebar."
msgstr ""
"ჩანართის ჩაგდების მიღება სამიზნე ფანჯრის ნებისმიერ ადგილას, მხოლოდ სათაურის "
"ზოლზე კი არა."

#: ../../WPrefs.app/Expert.c:111
msgid "Show workspace title on Clip."
msgstr "სამუშაო სივრცის სათაურის ჩვენება სამაგრზე."

#: ../../WPrefs.app/Expert.c:114
msgid ""
"Skip empty workspaces when switching with Next/Prev/Left/Right/Up/Down keys."
msgstr ""
"ცარიელი სამუშაო სივრცეების გამოტოვება შემდეგი/წინა/მარცხენა/მარჯვენა/ზემოთ/"
"ქვემოთ ღილაკებით გადართვისას."

#: ../../WPrefs.app/Expert.c:117
msgid "Highlight the icon of the application when it has the focus."
msgstr "აპლიკაციის ხატულას გამოკვეთა, როცა მას ფოკუსი აქვს."

#: ../../WPrefs.app/Expert.c:121
msgid "Enable keyboard language switch button in window titlebars."
msgstr "კლავიატურის ენის გადართვის ღილაკის ჩართვა ფანჯრის სათაურის ზოლებში."

#: ../../WPrefs.app/Expert.c:125
msgid "Snap a window to edge or corner by dragging."
msgstr "ფანჯრის მიმაგრება წიბოზე, ან კუთხეზე გადათრევით."

