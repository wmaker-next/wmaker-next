#: ../../WPrefs.app/Docks.c:38
msgid "Before auto-lowering"
msgstr "ავტოჩამოწევამდე"

#: ../../WPrefs.app/Docks.c:49
msgid ""
"Disable/enable the application Dock (the\n"
"icon bar pinned to a screen edge)."
msgstr ""
"აპლიკაციების დოკის (ეკრანის კიდეზე დამაგრებული\n"
"ხატულების ზოლის) ჩართვა/გამორთვა."

#: ../../WPrefs.app/Docks.c:51
msgid ""
"Disable/enable the Clip (that thing with\n"
"a paper clip icon)."
msgstr ""
"სამაგრის ( ის რაღაც, ქაღალდის\n"
"სამაგრის ხატულათი) გათიშვა/ჩართვა."

#: ../../WPrefs.app/Docks.c:53
msgid ""
"Disable/enable Drawers (a dock that stores\n"
"application icons horizontally). The dock is required."
msgstr ""
"უჯრების (დოკის, რომელიც აპლიკაციის ხატულებს\n"
"ჰორიზონტალურად ინახავს) ჩართვა/გამორთვა. დოკი აუცილებელია."

