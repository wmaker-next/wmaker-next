#: ../../WPrefs.app/Docks.c:296
msgid ""
"The screen edge the Dock is pinned to. Apply moves a\n"
"running Dock; dragging the Dock to another edge is\n"
"kept for this session and overwritten on the next Apply."
msgstr ""
"ეკრანის კიდე, რომელზეც დამაგრებულია დოკი. „გადატარება“\n"
"გადაადგილებს გაშვებულ დოკს; დოკის სხვა კიდეზე გადათრევა\n"
"ინახება ამ სესიისთვის და გადაიწერება შემდეგი\n"
"„გადატარებისას“."

#: ../../WPrefs.app/Docks.c:365
msgid "Dock Preferences"
msgstr "დოკის მორგება"

#: ../../WPrefs.app/Docks.c:367
msgid ""
"Dock and clip features.\n"
"Enable/disable the Dock and Clip, and tune some delays."
msgstr ""
"დოკის და სამაგრის თვისებები.\n"
"სამაგრის და დოკის ჩართვა/გამორთვა და ზოგიერთი დაყოვნების მორგება."

#: ../../WPrefs.app/Expert.c:49
msgid ""
"Disable miniwindows (icons for minimized windows). For use with KDE/GNOME."
msgstr ""
"მინიფანჯრების (ხატულები ჩაკეცილი ფანჯრებისთვის). გამოიყენეთ KDE/GNOME-სთან "
"მუშაობისას."

#: ../../WPrefs.app/Expert.c:52
msgid "Ignore decoration hints for GTK applications."
msgstr "დეკორაციის მინიშნებების იგნორი GTK-ის აპლიკაციებისთვის."

#: ../../WPrefs.app/Expert.c:55
msgid "Enable workspace pager."
msgstr "სამუშაო სივრცის პეიჯერის ჩართვა."

#: ../../WPrefs.app/Expert.c:58
msgid "Do not set non-WindowMaker specific parameters (do not use xset)."
msgstr ""
"არა-WindowMaker-ის სპეციფიკური პარამეტრების არდაყენება (xset-ის "
"არგამოყენება)."

#: ../../WPrefs.app/Expert.c:61
msgid "Automatically save session when exiting Window Maker."
msgstr "სესიის ავტომატური შენახვა Window Maker-დან გასვლისას."

#: ../../WPrefs.app/Expert.c:64
msgid "Use SaveUnder in window frames, icons, menus and other objects."
msgstr ""
"SaveUnder-ის გამოყენება ფანჯრის ჩარჩოებში, ხატულებში, მენიუებში და სხვა "
"ობიექტებში."

#: ../../WPrefs.app/Expert.c:67
msgid "Disable confirmation panel for the Kill command."
msgstr "დადასტურების პანელის გათიშვა მოკვლის ბრძანებისთვის."

#: ../../WPrefs.app/Expert.c:70
msgid "Disable selection animation for selected icons."
msgstr "მონიშვნის ანიმაციის გათიშვა მონიშნული ხატულებისთვის."

#: ../../WPrefs.app/Expert.c:73
msgid "Blink the titlebar of windows that demand attention."
msgstr "ყურადღების მომთხოვნი ფანჯრების სათაურის ზოლის ციმციმი."

#: ../../WPrefs.app/Expert.c:76
msgid "Cycle windows only on the active head."
msgstr "ფანჯრების წრიული გადართვა, მხოლოდ, აქტიურ თავზე."

#: ../../WPrefs.app/Expert.c:79
msgid "Let a new window on another head take focus automatically."
msgstr "სხვა მონიტორზე გახსნილმა ახალმა ფანჯარამ ავტომატურად მიიღოს ფოკუსი."

#: ../../WPrefs.app/Expert.c:82
msgid "Each monitor keeps its own active workspace (requires restart)."
msgstr ""
"თითოეული მონიტორი ინახავს საკუთარ აქტიურ სამუშაო სივრცეს (საჭიროებს "
"გადატვირთვას)."

#: ../../WPrefs.app/Expert.c:85
msgid "Keep at least this many workspaces."
msgstr "სამუშაო სივრცეების ეს მინიმალური რაოდენობა შენარჩუნდება."

#: ../../WPrefs.app/Expert.c:89
msgid "Enable virtual desktop (pannable workspaces larger than the screen)."
msgstr ""
"ვირტუალური დესკტოპის ჩართვა (ეკრანზე დიდი, გადასაადგილებელი სამუშაო "
"სივრცეები)."

#: ../../WPrefs.app/Expert.c:93
msgid "Cycle all windows from all workspaces."
msgstr "ყველა ფანჯრის წრიული გადართვა ყველა სამუშაო სივრციდან."

#: ../../WPrefs.app/Expert.c:96
msgid "Ignore minimized windows when cycling."
msgstr "ჩაკეცილი ფანჯრების იგნორი წრიული გადართვისას."

#: ../../WPrefs.app/Expert.c:99
msgid "Order the switch panel by creation time instead of focus history."
msgstr "გადამრთველი პანელის დალაგება შექმნის დროით, ფოკუსის ისტორიის ნაცვლად."

#: ../../WPrefs.app/Expert.c:102
msgid "Show app icons in window list."
msgstr "აპის ხატულების ჩვენება ფანჯრების სიაში."

#: ../../WPrefs.app/Expert.c:105
msgid "Show switch panel when cycling windows."
msgstr "გადართვის პანელის ჩვენება ფანჯრებს შორის წრიული გადართვისას."

#: ../../WPrefs.app/Expert.c:108
msgid "Show every tab-group member in the window switch panel."
msgstr "ყველა ჩანართის-ჯგუფის წევრის ჩვენება ფანჯრების გადამრთველ პანელში."

#: ../../WPrefs.app/Expert.c:111
msgid "Draw tab groups as titlebar segments instead of a [N/M] prefix."
msgstr ""
"ჩანართების ჯგუფების გამოსახვა სათაურის ზოლის სეგმენტებად, [N/M] პრეფიქსის "
"ნაცვლად."

#: ../../WPrefs.app/Expert.c:114
msgid "Accept tab drops anywhere on the target window, not just its titlebar."
msgstr ""
"ჩანართის ჩაგდების მიღება სამიზნე ფანჯრის ნებისმიერ ადგილას, მხოლოდ სათაურის "
"ზოლზე კი არა."

#: ../../WPrefs.app/Expert.c:117
msgid "Show workspace title on Clip."
msgstr "სამუშაო სივრცის სათაურის ჩვენება სამაგრზე."

#: ../../WPrefs.app/Expert.c:120
msgid ""
"Skip empty workspaces when switching with Next/Prev/Left/Right/Up/Down keys."
msgstr ""
"ცარიელი სამუშაო სივრცეების გამოტოვება შემდეგი/წინა/მარცხენა/მარჯვენა/ზემოთ/"
"ქვემოთ ღილაკებით გადართვისას."

#: ../../WPrefs.app/Expert.c:123
msgid "Highlight the icon of the application when it has the focus."
msgstr "აპლიკაციის ხატულას გამოკვეთა, როცა მას ფოკუსი აქვს."

#: ../../WPrefs.app/Expert.c:127
msgid "Enable keyboard language switch button in window titlebars."
msgstr "კლავიატურის ენის გადართვის ღილაკის ჩართვა ფანჯრის სათაურის ზოლებში."

#: ../../WPrefs.app/Expert.c:131
msgid "Snap a window to edge or corner by dragging."
msgstr "ფანჯრის მიმაგრება წიბოზე, ან კუთხეზე გადათრევით."

#: ../../WPrefs.app/Expert.c:134
msgid "Distance from edge to begin window snap."
msgstr "მანძილი წიბოდან ფანჯრის მიმაგრების დასაწყებად."

#: ../../WPrefs.app/Expert.c:137
msgid "Distance from corner to begin window snap."
msgstr "მანძილი კუთხიდან ფანჯრის მიმაგრების დასაწყებად."

#: ../../WPrefs.app/Expert.c:140
msgid "Snap a window to the top to maximize it to the full screen."
msgstr "მიამაგრეთ ფანჯარა ზედა მხარეს, რომ ის სრულ ეკრანზე გაიშალოს."

#: ../../WPrefs.app/Expert.c:143
msgid "Allow move half-maximized windows between multiple screens."
msgstr ""
"ნახევარ ეკრანზე გაშლილი ფანჯრების გადატანის დაშვება ერთზე მეტ ეკრანს შორის."

#: ../../WPrefs.app/Expert.c:146
msgid "Alternative transitions between states for half maximized windows."
msgstr ""
"ალტერნატიული გადასვლა ნახევრად გაფართოებული ფანჯრების მდგომარეობებს შორის."

#: ../../WPrefs.app/Expert.c:149
msgid "Move mouse pointer with half maximized windows."
msgstr "თაგუნას მაჩვენებლის გადაადგილება ნახევრად გაშლილი ფანჯრებით."

#: ../../WPrefs.app/Expert.c:152
msgid "Open dialogs in the same workspace as their owners."
msgstr "დიალოგების გახსნა იგივე სამუშაო სივრცეებში, სადაც მათი მფლობელებია."

#: ../../WPrefs.app/Expert.c:155
msgid "Wrap dock-attached icons around the screen edges."
msgstr "დოკზე მიმაგრებული ხატულების გადატანა ეკრანის წიბოებს შორის."

#: ../../WPrefs.app/Expert.c:158
msgid "Double click on titlebar maximizes a window instead of shading it."
msgstr "ორმაგი წკაპი სათაურის ზოლზე ფანჯარას გადიდებს მის დაჩრდილვის ნაცვლად."

#: ../../WPrefs.app/Expert.c:161
msgid "Close rootmenu when mouse (left or right) is clicked outside focus."
msgstr ""
"ძირითადი მენიუს დახურვა თაგუნათი (მარჯვენა, ან მარცხენა) წკაპი ფოკუსის გარეთ "
"ხდება."

#: ../../WPrefs.app/Expert.c:164
msgid "Keep dock on primary head."
msgstr "სამაგრის შენარჩუნება ძირითად თავზე."

#: ../../WPrefs.app/Expert.c:167
msgid "Allow windows to take focus using mouse wheel."
msgstr "ფანჯრებისთვის თაგუნას ბორბლით ფოკუსის აღების უფლების მიცემა."

#: ../../WPrefs.app/Expert.c:171
msgid "Automatically (de)activate monitors on hotplug events."
msgstr ""
"ეკრანების ავტომატური (დე)აქტივაცია ჩართულზე შეერთების/გამოერთების "
"შემთხვევაში."

#: ../../WPrefs.app/Expert.c:605
msgid "Expert User Preferences"
msgstr "ექსპერტი მომხმარებლის პარამეტრები"

#: ../../WPrefs.app/Expert.c:607
msgid ""
"Options for people who know what they're doing...\n"
"Also has some other misc. options."
msgstr ""
"პარამეტრები ხალხისთვის, ვინც იცის, რას აკეთებს...\n"
"ასევე აქვს სხვა, დამატებითი პარამეტრებიც."

#: ../../WPrefs.app/Focus.c:130 ../../WPrefs.app/HotCornerShortcuts.c:102
#: ../../WPrefs.app/Icons.c:154 ../../WPrefs.app/Icons.c:352
#: ../../WPrefs.app/Preferences.c:111 ../../WPrefs.app/WindowHandling.c:134
#: ../../WPrefs.app/WindowHandling.c:152 ../../WPrefs.app/WindowHandling.c:171
#, c-format
msgid "OFF"
msgstr "გამორთული"

#: ../../WPrefs.app/Focus.c:175
msgid "Input Focus Mode"
msgstr "შეყვანის ფოკუსის რეჟიმი"

#: ../../WPrefs.app/Focus.c:182
msgid "Manual:  Click on the window to set keyboard input focus"
msgstr ""
"ხელით:  დააწკაპუნეთ ფანჯარაზე კლავიატურის შეყვანის ფოკუსის დასაყენებლად"

#: ../../WPrefs.app/Focus.c:188
msgid "Auto:  Set keyboard input focus to the window under the mouse pointer"
msgstr ""
"ავტო:  კლავიატურის შეყვანის ფოკუსის დაყენება ფანჯარაზე, რომელიც თაგუნას "
"მაჩვენებლის ქვეშაა"

#: ../../WPrefs.app/Focus.c:200
msgid "Install colormap from the window..."
msgstr "ფერების რუკის დაყენება ფანჯრიდან..."

#: ../../WPrefs.app/Focus.c:202
msgid ""
"This option is for screens that can display only a limited number\n"
"of colors at a time, so they use an indexed table of colors (called\n"
"a ColorMap) that each application customizes for its needs, and\n"
"WindowMaker will set the global ColorMap dynamically from the\n"
"active application.\n"
"You can know the capability of your screen in WindowMaker's info\n"
"panel as the 'visual'."
msgstr ""
"ეს პარამეტრი ეკრანებისთვისაა, რომლებსაც, მხოლოდ შეზღუდული\n"
"რაოდენობის ფერების რაოდენობის ჩვენება შეუძლიათ ერთდროულად,\n"
"ასე რომ ისინი ფერების დაინდექსებულ ცხრილს იყენებენ (რომელსაც ფერთა\n"
"რუკა ეწოდება), რომელსაც თითოეული აპლიკაცია ისე ირგებს, როგორც სჭირდება და\n"
"WindowMaker დინამიკურად დააყენებს გლობალურ ფერთა რუკას აქტიური "
"აპლიკაციიდან.\n"
"თქვენი ეკრანის შესაძლებლობის გაგება WindowMaker-ის ინფორმაციის პანელში,\n"
"visual-ის მნიშვნელობით შეგიძლიათ."

#: ../../WPrefs.app/Focus.c:214
msgid "...that has the input focus"
msgstr "...რომელსაც აქვს შეყვანის ფოკუსი"

#: ../../WPrefs.app/Focus.c:219
msgid "...that's under the mouse pointer"
msgstr "...რომელიც არის თაგუნას მაჩვენებლის ქვეშ"

