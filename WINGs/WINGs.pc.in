prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: WINGs
Description: Small widget set with the NeXTStep(TM) look and feel
Version: @VERSION@
Requires: wrlib WUtil
Requires.private: cairo cairo-xcb pangocairo
Libs: @lib_search_path@ -lWINGs
Libs.private: @XCB_LIBS@ @XFT_LIBS@ @FCLIBS@ @XLIBS@ -lm @INTLIBS@
Cflags: @inc_search_path@ @CAIRO_CFLAGS@
