/* ---[ wcairo.c ]-------------------------------------------------------- */

/* forward-declared so callers can hold a cairo_t * without every
 * translation unit pulling in cairo.h */
typedef struct _cairo cairo_t;

typedef struct WCairoSurface WCairoSurface;

enum {
    /* pick rcontext->xvisual_argb for the on-server surface (falls back
     * to the default visual when the server has no depth-32 TrueColor) */
    WCairoARGB     = 1 << 0,
    /* WCairoBegin() draws into a client-side image surface and
     * WCairoEnd() blits the finished frame onto the xcb surface in one
     * SOURCE-operator paint, so a fill+text+border repaint never
     * flashes the intermediate stages */
    WCairoBuffered  = 1 << 1,
    /* WCairoEnd() destroys the WCairoSurface after the blit, used by
     * WCairoBeginBuffered() so the caller holds only a cairo_t */
    WCairoTransient = 1 << 2,
    /* WCairoBegin() applies cairo_scale(uiScale) so paint code stays
     * in logical units on a device-size backing store */
    WCairoScaled    = 1 << 3
};

/* one per Drawable that paints, cached lazily on the owning W_View or
 * WCoreWindow. flags is a bitmask of the WCairo* values above. */
WCairoSurface *WCairoSurfaceCreate(W_Screen *scr, xcb_drawable_t d,
                                   int width, int height, int flags);
void WCairoSurfaceResize(WCairoSurface *cs, int width, int height);
void WCairoSurfaceDestroy(WCairoSurface *cs);

cairo_t *WCairoBegin(WCairoSurface *cs);
/* transient path for a bare Drawable, size from the drawableSize
 * cache with an xcb_get_geometry fallback on miss */
cairo_t *WCairoBeginForDrawable(W_Screen *scr, xcb_drawable_t d);
/* same but into a client-side image buffer that WCairoEnd() blits in
 * one go, replacing the XCreatePixmap + draw + XCopyArea pattern */
cairo_t *WCairoBeginBuffered(W_Screen *scr, xcb_drawable_t d);
/* flushes the target surface, warns on cairo error, destroys cr */
void WCairoEnd(cairo_t *cr);

void W_SetSourceColor(cairo_t *cr, WMColor *color);
void W_SetSourceRColor(cairo_t *cr, const RColor *color);
void W_SetSourceXColor(cairo_t *cr, const WXColor *color);

/* the FillStippled 50% checkerboard in darkGray, masked over whatever
 * fill sits below (the widget-slot and progress-bar interiors) */
void W_StippleFill(cairo_t *cr, W_Screen *scr, int x, int y, int w, int h);

/* paint a WMPixmap at (x, y), masked through its depth-1 mask when it
 * has one, else clipped to its own extents. A depth-1 image is painted
 * as a black shape (bit=1 lands, bit=0 leaves the destination). */
void W_PaintPixmap(cairo_t *cr, WMPixmap *pixmap, int x, int y);

/* copy a w x h rectangle from (sx, sy) on a screen-depth server
 * drawable src (whose full extents are srcW x srcH) onto the caller's
 * cairo target at (dx, dy) */
void W_PaintArea(cairo_t *cr, W_Screen *scr, xcb_drawable_t src, int srcW, int srcH,
                     int sx, int sy, int w, int h, int dx, int dy);
/* true when d was created at logical*uiScale device pixels, in which
 * case width/height receive the recorded device extents */
int WMGetDrawableScaledSize(W_Screen *scr, xcb_drawable_t d, int *width, int *height);
/* one-shot server-side copy: open a transient cr on dst, blit, close */
void W_CopyArea(W_Screen *scr, xcb_drawable_t src, int srcW, int srcH,
                    int sx, int sy, int w, int h, xcb_drawable_t dst, int dx, int dy);

/* fill the target with the view's background: an explicit WMColor if
 * given, else the view's background pixmap tiled, else its backColor */
void W_PaintViewBackground(cairo_t *cr, W_View *view, WMColor *backColor);

/* speech-bubble path: rounded body at (x,y,w,h) with a triangular
 * tail on the top or bottom edge near the left or right corner */
enum {
    WCairoBalloonBottom = 1 << 0,
    WCairoBalloonRight  = 1 << 1
};
void W_BalloonPath(cairo_t *cr, double x, double y, double w, double h,
                       int side, double tail_len);

/* render that path into a fresh depth-1 mask pixmap for ShapeBounding
 * and a fresh depth-N content pixmap for the window background, both
 * width x height (which already includes the tail-length pad),
 * caller draws text on *content and frees both */
void W_RenderBalloon(W_Screen *scr, unsigned int width, unsigned int height,
                         double bx, double by, double bw, double bh,
                         int side, double tail_len,
                         WMColor *fill, WMColor *border,
                         xcb_pixmap_t *content, xcb_pixmap_t *mask);

/* refresh scr->compositor_running from the _NET_WM_CM_Sn owner */
int W_ScreenCheckCompositor(W_Screen *scr);


