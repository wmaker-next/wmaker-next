/* ---[ wxkb.c ]---------------------------------------------------------- */

/* load the per-screen xkbcommon stack (context, keymap, state, compose)
 * via xkb_x11_* and select the XKB events the refresh arm in
 * WMHandleEvent() consumes; no-op when the server has no XKB */
void W_InitXkb(W_Screen *scr);

/* release the per-screen xkbcommon stack and remove the screen from
 * W_XkbHandleEvent()'s walk, no-op without a live stack */
void W_DeinitXkb(W_Screen *scr);

/* XKB extension event pump, called from WMHandleEvent() before view
 * lookup, returns True when the event was an XKB event this screen
 * selected for */
bool W_XkbHandleEvent(xcb_generic_event_t *event);

/* the screen's struct xkb_state *, NULL when W_InitXkb() did not run
 * or failed; W_LookupString()'s xcb arm and the unit tests feed this
 * to W_XkbLookupString() */
void *W_XkbStateOf(W_Screen *scr);

/* the modifier slot each named modifier is bound to (the Xlib
 * ShiftMapIndex..Mod5MapIndex columns), -1 when unbound */
typedef struct WXModifierSlots {
	int alt, meta, super, hyper, mode_switch;
	int numlock, scrolllock;
} WXModifierSlots;

/* the named-modifier bindings of a connection against a keymap, the
 * one classification every modifier walk shares */
void W_XkbModifierSlots(xcb_connection_t *xc, struct xkb_keymap *keymap,
			WXModifierSlots *slots);

/* first keysym at `level` across the screen's keymap layouts,
 * XKB_KEY_NoSymbol when no layout carries one at that level */
xkb_keysym_t W_XkbKeysymForKeycode(W_Screen *scr, xcb_keycode_t kc, int level);

/* recompute the screen's ignoredModifierMask and altModifierMask from
 * its keymap, at screen creation and on every XKB keymap reload */
void W_UpdateScreenModifierMasks(W_Screen *scr);

/* XKeysymToKeycode equivalent against the screen's xkb keymap, 0 when
 * the keymap does not carry the keysym (or no xkb stack exists). */
xcb_keycode_t W_KeysymToKeycode(W_Screen *scr, xkb_keysym_t keysym);

/* keymap-only core of W_KeysymToKeycode for the headless tests. */
xcb_keycode_t W_XkbKeysymToKeycode(void *keymap, xkb_keysym_t keysym);

/* Xutil.h's IsModifierKey against xkbcommon keysyms: Shift_L..Hyper_R. */
bool W_IsModifierKey(xkb_keysym_t keysym);

/* ---[ wxhints.c, the client-side text-property codec ]------------------- */

/* Latin-1 bytes to UTF-8, wmalloc()ed. */
char *W_Latin1ToUtf8(const unsigned char *in, size_t len);

/* one decoded UTF-8 character: stores the codepoint and returns its
 * byte length, 0 on a malformed sequence */
int W_Utf8Next(const unsigned char *s, size_t len, unsigned int *cp);

/* UTF-8 to Latin-1 bytes when every codepoint fits, NULL otherwise
 * (the STRING encoding contract); wmalloc()ed. */
char *W_Utf8ToLatin1(const char *s, size_t len, size_t *outlen);

/* xcb-path lookup core shared with W_LookupString(), state and compose
 * state passed in void * so the unit tests can drive it without a
 * server */
int W_XkbLookupString(void *xkb_state, void *compose_state,
                      const xcb_key_press_event_t *event,
                      char *buffer, int buflen,
                      xkb_keysym_t *keysym, WXLookupStatus *status);


/* ---[ wmisc.c ]--------------------------------------------------------- */

/* draw the same bevel onto a live cairo_t so a caller that already
 * has one open (WOSDView, wframe.c after it sets a clip) folds the
 * relief into its own paint pass */
void W_DrawRelief(cairo_t *cr, W_Screen *scr, int x, int y,
                       unsigned int width, unsigned int height,
                       WMReliefType relief);

void W_PaintTextAndImage(W_View *view, int wrap, WMColor *textColor,
                         W_Font *font, WMReliefType relief, const char *text,
                         WMAlignment alignment, W_Pixmap *image,
                         WMImagePosition position, WMColor *backColor, int ofs);

void W_PaintTextAndImageMarkup(W_View *view, int wrap, WMColor *textColor,
                               W_Font *font, WMReliefType relief,
                               WMAlignment alignment, W_Pixmap *image,
                               WMImagePosition position, WMColor *backColor,
                               int ofs, PangoLayout *markupLayout);

void W_PaintText(cairo_t *cr, WMFont *font, int x, int y,
                      int width, WMAlignment alignment, WMColor *color,
                      int wrap, const char *text, int length);

int W_GetTextHeight(WMFont *font, const char *text, int width, int wrap);


/* ---[ wpixmap.c ]------------------------------------------------------- */

struct W_Pixmap {
    struct W_Screen *screen;
    xcb_pixmap_t pixmap;
    xcb_pixmap_t mask;
    unsigned short width;
    unsigned short height;
    short depth;
    short refCount;
};


/* ---[ wview.c ]--------------------------------------------------------- */

typedef struct W_ViewDelegate {
    void *data;
    void (*didMove)(struct W_ViewDelegate*, WMView*);
    void (*didResize)(struct W_ViewDelegate*, WMView*);
    void (*willMove)(struct W_ViewDelegate*, WMView*, int*, int*);
    void (*willResize)(struct W_ViewDelegate*, WMView*,
                       unsigned int*, unsigned int*);
} W_ViewDelegate;

struct W_View {
    struct W_Screen *screen;

    WMWidget *self;     /* must point to the widget the view belongs to */

    W_ViewDelegate *delegate;

    xcb_window_t window;

    WMSize size;

    short topOffs;
    short leftOffs;
    short bottomOffs;
    short rightOffs;

    WMPoint pos;

    struct W_View *nextFocusChain;     /* next/prev in focus chain */
    struct W_View *prevFocusChain;

    struct W_View *nextResponder;      /* next to receive keyboard events */

    struct W_View *parent;             /* parent WMView */

    struct W_View *childrenList;       /* first in list of child windows */

    struct W_View *nextSister;         /* next on parent's children list */

    WMArray *eventHandlers;            /* event handlers for this window */

    uint32_t attribFlags;
    WXSetWindowAttributes attribs;

    void *hangedData;                  /* data holder for user program */

    WMColor *backColor;
    WMPixmap *backImage;


    xcb_cursor_t cursor;

    xcb_atom_t *droppableTypes;
    struct W_DragSourceProcs      *dragSourceProcs;
    struct W_DragDestinationProcs *dragDestinationProcs;
    WMPixmap *dragImage;
    int helpContext;

    uint16_t xcbxic;  /* xcb_xic_t once the IM server created it; 0 = not created */
    uint32_t xcbxic_fwd_mask; /* forward_event_mask from xcb-imdkit set_event_mask */

    struct {
        unsigned int realized:1;
        unsigned int mapped:1;
        unsigned int parentDying:1;
        unsigned int dying:1;           /* the view is being destroyed */
        unsigned int topLevel:1;        /* is a top level window */
        unsigned int root:1;            /* is the root window */
        unsigned int mapWhenRealized:1; /* map the view when it's realized */
        unsigned int alreadyDead:1;     /* view was freed */

        unsigned int dontCompressMotion:1; /* motion notify event compress */
        unsigned int notifySizeChanged:1;
        unsigned int dontCompressExpose:1; /* expose event compress */

        /* toplevel only */
        unsigned int worksWhenModal:1;
        unsigned int pendingRelease1:1;
        unsigned int pendingRelease2:1;
        unsigned int pendingRelease3:1;
        unsigned int pendingRelease4:1;
        unsigned int pendingRelease5:1;
        unsigned int xdndHintSet:1;

        /* this view asked for an IM input context (winputmethod.c);
         * retried by the reconnect walk when the IM opens late */
        unsigned int xcbxic_wanted:1;

        /* create the window on screen->visual_argb at depth 32 with
         * rcontext->cmap_argb. Set before realize by widgets that
         * paint their whole surface through cairo and want a working
         * alpha channel under a compositor. Ignored when the server
         * has no depth-32 visual. */
        unsigned int argb:1;
    } flags;

    int refCount;
};

#define W_VIEW_REALIZED(view)	(view)->flags.realized
#define W_VIEW_MAPPED(view)	(view)->flags.mapped

#define W_VIEW_DISPLAY(view)    (view)->screen->display
#define W_VIEW_SCREEN(view)	(view)->screen
#define W_VIEW_DRAWABLE(view)	(view)->window

#define W_VIEW_WIDTH(view)	(view)->size.width
#define W_VIEW_HEIGHT(view)	(view)->size.height

/* -- Functions -- */

W_View *W_GetViewForXWindow(xcb_window_t window);

W_View *W_CreateView(W_View *parent);

W_View *W_CreateTopView(W_Screen *screen);

W_View *W_CreateUnmanagedTopView(W_Screen *screen);

W_View *W_CreateRootView(W_Screen *screen);

void W_DestroyView(W_View *view);

void W_RealizeView(W_View *view);

void W_RedisplayView(WMView *view);

void W_ReparentView(W_View *view, W_View *newParent, int x, int y);

void W_RaiseView(W_View *view);

void W_LowerView(W_View *view);

void W_MapView(W_View *view);

void W_MapSubviews(W_View *view);

void W_UnmapSubviews(W_View *view);

W_View *W_TopLevelOfView(W_View *view);

void W_UnmapView(W_View *view);

WMView *W_RetainView(WMView *view);

void W_ReleaseView(WMView *view);

void W_MoveView(W_View *view, int x, int y);

void W_ResizeView(W_View *view, unsigned int width, unsigned int height);

void W_SetViewBackgroundColor(W_View *view, WMColor *color);

void W_SetViewBackgroundPixmap(W_View *view, WMPixmap *pix);

void W_SetViewCursor(W_View *view, xcb_cursor_t cursor);

void W_SetFocusOfTopLevel(W_View *toplevel, W_View *view);

W_View *W_FocusedViewOfToplevel(W_View *view);


/* ---[ UTF-8 helpers ]--------------------------------------------------- */

static inline int oneUTF8CharBackward(const char *str, int len)
{
	const unsigned char *ustr = (const unsigned char *)str;
	int pos = 0;

	while (len-- > 0 && ustr[--pos] >= 0x80 && ustr[pos] <= 0xbf) ;
	return pos;
}

static inline int oneUTF8CharForward(const char *str, int len)
{
	const unsigned char *ustr = (const unsigned char *)str;
	int pos = 0;

	while (len-- > 0 && ustr[++pos] >= 0x80 && ustr[pos] <= 0xbf) ;
	return pos;
}

// find the beginning of the UTF8 char pointed by str
static inline int seekUTF8CharStart(const char *str, int len)
{
	const unsigned char *ustr = (const unsigned char *)str;
	int pos = 0;

	while (len-- > 0 && ustr[pos] >= 0x80 && ustr[pos] <= 0xbf)
		--pos;
	return pos;
}


