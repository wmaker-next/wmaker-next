prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: wrlib
Description: Image manipulation and conversion library
Version: @VERSION@
Requires: xcb
Requires.private: xcb-shm xcb-image
Libs: @lib_search_path@ -lwraster
Libs.private: @GFXLIBS@ @MAGICKLIBS@ @XLIBS@ -lm
Cflags: @inc_search_path@
