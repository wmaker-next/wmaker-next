#!/bin/sh
#
# Install Window Maker for the current user
#

# xx herbert
if test "x$1" = "x--batch" ; then
  BATCH="1"
else
  BATCH=""
fi
# /xx herbert

# name of menu file we install (menu, plmenu)
inst_menu=""

LOCALE="${LC_ALL-${LC_MESSAGES-$LANG}}"

# directory where system wide configuration is stored
GLOBALDIR="#pkgdatadir#"
GLOBALDEFDIR="#sysconfdir#"

USERDIR="$HOME"

VERSION="#version#"

BINDIR="#bindir#"

make_dir() {
	mkdir "$1"
	chmod +rwx "$1"
}

#
# Copy files, rewriting any user-root placeholder to the resolved paths.
# The substitutions are no-ops on files that do not contain a placeholder.
# The paths come from the environment and are inserted literally: sed
# would treat &, \ and the delimiter in them as replacement syntax and
# choke on embedded newlines, so the rewrite runs through awk instead.
#
copy() {
	source="$1"
	target="$2"
	rm -f "$target"
	GSDIR="$GSDIR" WDATADIR="$WDATADIR" WCACHEDIR="$WCACHEDIR" \
	awk '
	function replace_all(s, from, to,    out, p) {
		out = ""
		while ((p = index(s, from)) > 0) {
			out = out substr(s, 1, p - 1) to
			s = substr(s, p + length(from))
		}
		return out s
	}
	{
		$0 = replace_all($0, "$WMAKER_USER_ROOT", ENVIRON["GSDIR"])
		$0 = replace_all($0, "$WMAKER_USER_DATA", ENVIRON["WDATADIR"])
		$0 = replace_all($0, "$WMAKER_USER_CACHE", ENVIRON["WCACHEDIR"])
		$0 = replace_all($0, "$HOME/GNUstep", ENVIRON["GSDIR"])
		$0 = replace_all($0, "~/GNUstep", ENVIRON["GSDIR"])
		print
	}' "$source" > "$target"
}

#
# Generate WMRootmenu
#
GenerateMenu() {
	wmgenmenu > "$WDEFAULTSDIR/WMRootMenu"
}

echo "Installing WindowMaker $VERSION for current user..."


if [ ! -d "$GLOBALDIR" ]; then
      echo "Could not find global data files"
      echo "Make sure you have installed Window Maker correctly"
      exit 1
fi

if [ ! -d "$GLOBALDEFDIR" ]; then
      echo "Could not find global configurations files"
      echo "Make sure you have installed Window Maker correctly"
      exit 1
fi

if [ ! -d "$USERDIR" ]; then
      echo "Could not find user directory $USERDIR"
      exit 1
fi


#
# Resolve the user configuration root, must match wusergnusteppath():
#   1. $WMAKER_USER_ROOT
#   2. ~/GNUstep when ~/GNUstep/Defaults already exists (legacy install)
#   3. ${XDG_CONFIG_HOME:-~/.config}/WindowMaker
#
# The first two keep the legacy single-tree layout with everything under
# $GSDIR. The third splits config/data/cache across the XDG basedirs.
#
if test "x$WMAKER_USER_ROOT" != "x"; then
	GSDIR="$WMAKER_USER_ROOT"
	WDEFAULTSDIR="$GSDIR/Defaults"
	WDATADIR="$GSDIR/Library/WindowMaker"
	WCACHEDIR="$WDATADIR"
elif [ -d "$USERDIR/GNUstep/Defaults" ]; then
	GSDIR="$USERDIR/GNUstep"
	WDEFAULTSDIR="$GSDIR/Defaults"
	WDATADIR="$GSDIR/Library/WindowMaker"
	WCACHEDIR="$WDATADIR"
else
	GSDIR="${XDG_CONFIG_HOME:-$USERDIR/.config}/WindowMaker"
	WDEFAULTSDIR="$GSDIR"
	WDATADIR="${XDG_DATA_HOME:-$USERDIR/.local/share}/WindowMaker"
	WCACHEDIR="${XDG_CACHE_HOME:-$USERDIR/.cache}/WindowMaker"
fi

for d in "$GSDIR" "$WDEFAULTSDIR" "$WDATADIR" "$WCACHEDIR"; do
	if [ ! -d "$d" ]; then
		echo "Creating $d"
		mkdir -p "$d" || {
			echo "Directory $d does not exist and could not be created"
			exit 1
		}
		chmod +rwx "$d" || exit 1
	fi
done

echo "Copying defaults database..."

FILES="$(cd "$GLOBALDEFDIR" && ls -d *)"
all=""
for i in $FILES; do
	if [ ! -d "$GLOBALDEFDIR/$i" ]; then
		if [ -f "$WDEFAULTSDIR/$i" -a -z "$BATCH" ]; then
			echo "The configuration file \"$i\" already exists in your defaults database."
			echo "Do you wish to replace it? <y/n/a> [n] $all"
			if [ "$all" != "a" ]; then
				read foo
				if [ "$foo" = "a" -o "$foo" = "A" ]; then
					all="a"
				fi
			fi
			if [ "$foo" = "y" -o "$foo" = "Y" -o "$all" = "a" ]; then
				copy "$GLOBALDEFDIR/$i" "$WDEFAULTSDIR/$i"
			fi
		else
			copy "$GLOBALDEFDIR/$i" "$WDEFAULTSDIR/$i"
		fi
	fi
done

	GenerateMenu

for sub in Icons Styles Themes Backgrounds IconSets Pixmaps Sounds; do
	if [ ! -d "$WDATADIR/$sub" ]; then
		echo "Creating $sub library $WDATADIR/$sub"
		make_dir "$WDATADIR/$sub"
	fi
done

if [ ! -d "$WCACHEDIR/CachedPixmaps" ]; then
	make_dir "$WCACHEDIR/CachedPixmaps"
fi

if [ ! -d "$WCACHEDIR/WPrefs" ]; then
	make_dir "$WCACHEDIR/WPrefs"
fi

if test -z "#LITE#" ; then
FILES="$(cd "$GLOBALDIR" && ls menu menu.* plmenu plmenu.?? wmmacros)"
for i in $FILES; do
# xx herbert
	if [ -f "$WDATADIR/$i" -a -z "$BATCH" ]; then
# /xx herbert
		echo "The file \"$i\" already exists in $WDATADIR"
		echo "Do you wish to replace it? <y/n/a> [n] $all"
		if [ "$all" != "a" ]; then
			read foo
			if [ "$foo" = "a" -o "$foo" = "A" ]; then
				all="a"
			fi
		fi
		if [ "$foo" = "y" -o "$foo" = "Y" -o "$foo" = "a" ]; then
			copy "$GLOBALDIR/$i" "$WDATADIR/$i"
		fi
	else
		copy "$GLOBALDIR/$i" "$WDATADIR/$i"
	fi
done
fi

cp "$GLOBALDIR/README.themes" "$WDATADIR"
cp "$GLOBALDIR/README" "$WDATADIR"

test -f "$WDATADIR/autostart" || \
    cp "$GLOBALDIR/autostart.sh" "$WDATADIR/autostart"
chmod +rx "$WDATADIR/autostart"

test -f "$WDATADIR/exitscript" || \
    cp "$GLOBALDIR/exitscript.sh" "$WDATADIR/exitscript"
chmod +rx "$WDATADIR/exitscript"

# xx herbert
if test -n "$BATCH" ; then
  echo "Installation Finished"
  exit 0
fi
# /xx herbert


#
#######################

DATE="$(date +%b%d.%T)"

show_end_message() {

echo
echo "Installation Finished"
echo
echo "There are menus in 2 different file formats. The plain text format and"
echo "the property list format. The plain text format is more flexible, but"
echo "the menu in the property list format can be edited graphically. The"
echo "menu that will be used by default is the property list one. Read"
echo "    $WDATADIR/README"
echo "for information on how to change it."
  if [ "${inst_menu%.*}" = "menu" ]; then
echo "However, since you have locale set to $LOCALE and plmenu for such locale"
echo "was not found, your WMRootMenu contains path to text formated menu:"
echo "    $WDATADIR/$inst_menu"
  fi
}

wmaker_found=0
for xinit in .xinitrc .Xclients .xsession; do
     test ! -f "$HOME/$xinit" && continue
	 res="$(grep wmaker "$HOME/$xinit")"
     if test "x$res" != x; then
     	wmaker_found=1
	break
     fi
done
if test "$wmaker_found" = 1; then
	echo "Found Window Maker to already be your default window manager."
	show_end_message
	exit 0
fi


trap "show_end_message;exit" 2

show_end_message
