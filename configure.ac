dnl Archive Support for wmiv
dnl =================================
dnl libarchive ships a .pc, use PKG_CHECK_MODULES so transitive private
dnl dependencies (lzma, zstd, lz4, bz2, zlib, ...) reach a static link
WM_OPTIONAL_DEP([LIBARCHIVE], [libarchive], [have_libarchive],
    [with], [libarchive],
    [--with-libarchive@<:@=auto|yes|no@:>@],
    [enable archive (.tar/.zip/.cbz/...) support in wmiv @<:@default=auto@:>@],
    [AC_DEFINE([HAVE_LIBARCHIVE], [1], [Define if libarchive is available])
     supported_gfx="$supported_gfx libarchive"],
    [libarchive])


dnl ==============================================
dnl         End of Graphic Format Libraries
dnl ==============================================


dnl ==============================================
dnl         Sound daemon (PipeWire + libsndfile)
dnl ==============================================
dnl wmaker only emits sound IPC events, it never links PipeWire or
dnl libsndfile. Both probes gate the wmsoundd player daemon, an optional
dnl util program subscribed to the WIPC sound event stream. libsndfile
dnl decodes WAV/AIFF/AU/FLAC/Ogg/Opus/MP3 so the freedesktop sound theme
dnl files under /usr/share/sounds/ are usable out of the box
WM_OPTIONAL_DEP([WSOUND], [libpipewire-0.3 sndfile], [have_pipewire],
    [with], [pipewire],
    [--with-pipewire@<:@=auto|yes|no@:>@],
    [build the wmsoundd event player daemon @<:@default=auto@:>@],
    [AC_DEFINE([HAVE_PIPEWIRE], [1], [Define if PipeWire is available])
     supported_sound="$supported_sound wmsoundd"],
    [wmsoundd],
    [BUILD_WSOUND])


dnl ==============================================
dnl         Touchpad gesture daemon (libinput + libudev)
dnl ==============================================
dnl wmaker learns nothing new about gestures: wmtouchd reads three- and
dnl four-finger swipes via libinput and delivers them through the generic
dnl `action NAME' IPC verb. Neither libinput nor libudev may enter wmaker,
dnl libWINGs or libWUtil, only this optional util daemon.
WM_OPTIONAL_DEP([WTOUCH], [libinput >= 1.19 libudev], [have_libinput],
    [with], [libinput],
    [--with-libinput@<:@=auto|yes|no@:>@],
    [build the wmtouchd touchpad gesture daemon @<:@default=auto@:>@],
    [AC_DEFINE([HAVE_LIBINPUT], [1], [Define if libinput is available])
     supported_input="$supported_input wmtouchd"],
    [wmtouchd],
    [BUILD_WTOUCH])


