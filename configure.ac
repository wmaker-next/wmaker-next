dnl XCB for the typed property/ICCCM layer
dnl =========================================================
dnl xcb-icccm 0.3.8 renamed every public symbol from xcb_* to xcb_icccm_*,
dnl wxhints.c uses the new names so reject the older API at configure time
dnl rather than failing the build (NetBSD base X11R7 still ships 0.3.6,
dnl install pkgsrc xcb-util-wm and put /usr/pkg/lib/pkgconfig first)
dnl xcb-randr/shape/sync/xkb provide the typed extension event structs that
dnl src/event.c and src/wmspec.c read after the WINGs queue flips to xcb,
dnl all four ship in the libxcb tarball so the version floor is shared.
dnl the plain xcb module gets its own 1.15 floor: the queue and put-back
dnl sites read xcb_generic_event_t.full_sequence (full 32-bit serials),
dnl 1.14 headers lack the field and would fail with a confusing error
dnl xkbcommon and xkbcommon-x11 own the keymap and keyboard state in
dnl src/wxkb.c so the resolver no longer reads the libX11 cache, both ship
dnl in the libxkbcommon tarball with the X11 module needing 0.4.1 for
dnl xkb_x11_setup_xkb_extension
dnl xcb-xtest drives wmclipd's paste keystroke injection without the libXtst
dnl Xlib binding, keeping the clipboard daemon off libX11's XTest wrapper.
dnl xcb-xinerama is the generated module for the head fallback in
dnl src/xinerama.c (servers exposing Xinerama without a RandR description,
dnl e.g. nested servers, and builds without RandR).
WM_REQUIRE_DEP([XCB],
    [xcb >= 1.15 xcb-icccm >= 0.3.8 xcb-randr xcb-shape xcb-sync xcb-xkb xcb-xfixes xcb-xtest xcb-xinerama xcb-cursor xkbcommon >= 0.8.0 xkbcommon-x11 >= 0.4.1],
    [libxcb >= 1.15, xcb-icccm >= 0.3.8, xcb-randr/shape/sync/xkb/xfixes/xtest/xinerama, xcb-cursor and xkbcommon/-x11 are required])
dnl AC_PATH_XTRA put the base X11 lib dir into LDFLAGS above, on NetBSD that
dnl is /usr/X11R7/lib which still carries the pre-0.3.8 libxcb-icccm.so.1, so
dnl ask pkg-config where the >= 0.3.8 module actually lives and search that
dnl directory ahead of XLFLAGS, on Linux/FreeBSD/OpenBSD libdir is the same
dnl as the base X dir and the prepend is a no-op
wm_xcb_icccm_libdir=`$PKG_CONFIG --variable=libdir 'xcb-icccm >= 0.3.8' 2>/dev/null`
AS_IF([test -n "$wm_xcb_icccm_libdir"],
    [LDFLAGS="-L$wm_xcb_icccm_libdir $LDFLAGS"])
AC_SUBST(XCB_CFLAGS)
AC_SUBST(XCB_LIBS)

dnl Core xcb only, for the standalone clients (wxcopy/wxpaste and the
dnl wrlib demo tools) that must not inherit the full extension set.
PKG_CHECK_MODULES([XCB_CORE], [xcb])
AC_SUBST(XCB_CORE_CFLAGS)
AC_SUBST(XCB_CORE_LIBS)


dnl Cairo rendering and PangoCairo text layout (required)
dnl =====================================================
dnl cairo-xcb draws onto the shared xcb connection resolved above and
dnl pangocairo is the WINGs text render sink. cairo 1.16 is the floor for
dnl a stable cairo-xcb backend and pango 1.44 is the floor for the
dnl fontconfig module, both in every maintained distribution.
dnl WINGs/wfont.c calls pango_fc_font_description_from_pattern() directly,
dnl so pangofc must be linked explicitly: some linkers (DragonFly base
dnl binutils) do not resolve symbols through the transitive
dnl libpangocairo -> libpangoft2 dependency chain.
WM_REQUIRE_DEP([CAIRO], [cairo >= 1.16 cairo-xcb pangocairo >= 1.44 pangofc],
    [cairo (>= 1.16 with the xcb backend) and pango (>= 1.44) are required])
AC_SUBST(CAIRO_CFLAGS)
AC_SUBST(CAIRO_LIBS)


dnl xcb-screensaver delivers MIT-SCREEN-SAVER notify events on the
dnl existing X fd so the window manager can disarm decorative timers
dnl while the server has blanked or DPMS-powered the display, ships in
dnl the libxcb tarball but distros split it into its own -dev package
dnl so probe softly
WM_OPTIONAL_DEP([XCB_SCREENSAVER], [xcb-screensaver], [have_xcb_screensaver],
    [with], [xcb-screensaver],
    [--without-xcb-screensaver],
    [do not use the MIT-SCREEN-SAVER extension for display-off detection],
    [AC_DEFINE([USE_XCB_SCREENSAVER], [1],
               [defined when xcb-screensaver is available so wmaker can react to ScreenSaverNotify])
     supported_xext="$supported_xext MIT-SCREEN-SAVER"],
    [MIT-SCREEN-SAVER])


dnl xcb-xinput delivers raw key, button and motion events on the root
