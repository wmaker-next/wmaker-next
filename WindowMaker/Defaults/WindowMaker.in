	/*
	 * Accent Picker is disabled by default so upgrades never take a key
	 * away from applications. To enable the held trigger:
	 *   AccentPickerKey = Menu;
	 * Then hold Menu, press a letter, tap the letter again to cycle,
	 * release Menu to commit. Escape cancels.
	 *
	 * Optional modifier mode: map CapsLock to Hyper with
	 *   setxkbmap -option caps:hyper
	 * then set AccentPickerModifier = Hyper and press Hyper+letter.
	 * Space cycles and releasing Hyper commits.
	 *
	 * AccentPickerSets = ("auto", "Currency");
	 * AccentPickerSets = ("auto", "Currency", "IPA");
	 */
	AccentPickerModifier = None;
	AccentPickerSets = ("auto", "Currency");
